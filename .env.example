# Server Port (Railway sets PORT automatically)
PORT=3001

# Railway PostgreSQL Connection String (Optional locally - falls back to local JSON DB if not set)
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=

# Frontend API URL for Vercel deployment pointing to Railway backend
# Leave empty when running locally or serving full-stack from a single host
VITE_API_URL=

